// osckdf_tests.nv — SHA-256, HMAC-SHA-256 and HKDF-SHA-256.
//
// GENERATED by tests/generate/gen_kdf_vectors.py; edit the generator, not this file.
//
// The HMAC vectors are RFC 4231 section 4, test cases 1, 2, 3, 4, 6 and 7 (test
// case 5 is a truncated MAC), cut out of the RFC's text.  Cases 6 and 7 have a
// key of 131 bytes, which is hashed before use.  The HKDF vectors are RFC 5869
// appendix A, test cases 1 to 3.  They derive 42 or 82 bytes, and this package
// derives the first 32: the first block of the expansion.  The SHA-256 digests
// are of the messages whose byte i is i mod 251, at the lengths where the
// padding changes shape, 55 to 57 and 119 to 120 among them; they were
// computed with Python's hashlib, which shares no code with this package.

use std.test
use std.bytes
use osckdf

fn load(s: Str) -> Vec[u8; 256]
    var m: Vec[u8; 256] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = m.push((bytes.byte_at(raw, i) ?? 0) as u8)
    m

fn hex32(var d: Vec[u8; 32]) -> Str
    var b = bytes.zeros(d.len())
    for i in 0..d.len()
        bytes.set_u8(b, i, d[i] as Int)
    bytes.to_hex(b)

fn sha(msg: Str) -> Str
    var m = load(msg)
    var d: Vec[u8; 32] = Vec.new()
    osckdf.sha256(var m, m.len(), var d)
    hex32(var d)

fn mac(key: Str, data: Str) -> Str
    var k = load(key)
    var m = load(data)
    var d: Vec[u8; 32] = Vec.new()
    osckdf.hmac_sha256(var k, k.len(), var m, m.len(), var d)
    hex32(var d)

fn hkdf_first(ikm: Str, salt: Str, info: Str) -> Str
    var i = load(ikm)
    var s = load(salt)
    var inf = load(info)
    var prk: Vec[u8; 32] = Vec.new()
    osckdf.hkdf_extract(var s, s.len(), var i, i.len(), var prk)
    var t1: Vec[u8; 32] = Vec.new()
    osckdf.hkdf_expand_first(var prk, var inf, inf.len(), var t1)
    hex32(var prk) + "/" + hex32(var t1)

@test
fn test_sha256_of_the_nist_examples() [io]
    test.case("the empty message")
    test.assert_eq_str(sha(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    test.case("abc")
    test.assert_eq_str(sha("616263"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    test.case("the 56-byte message of FIPS 180-4, two blocks")
    test.assert_eq_str(sha("6162636462636465636465666465666765666768666768696768696a68696a6b696a6b6c6a6b6c6d6b6c6d6e6c6d6e6f6d6e6f706e6f7071"),
                       "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

@test
fn test_sha256_at_the_lengths_where_the_padding_changes() [io]
    test.case("0 bytes")
    test.assert_eq_str(sha(""),
                       "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    test.case("1 bytes")
    test.assert_eq_str(sha("00"),
                       "6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d")
    test.case("3 bytes")
    test.assert_eq_str(sha("000102"),
                       "ae4b3280e56e2faf83f414a6e3dabe9d5fbe18976544c05fed121accb85b53fc")
    test.case("55 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30313233343536"),
                       "463eb28e72f82e0a96c0a4cc53690c571281131f672aa229e0d45ae59b598b59")
    test.case("56 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031323334353637"),
                       "da2ae4d6b36748f2a318f23e7ab1dfdf45acdc9d049bd80e59de82a60895f562")
    test.case("57 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738"),
                       "2fe741af801cc238602ac0ec6a7b0c3a8a87c7fc7d7f02a3fe03d1c12eac4d8f")
    test.case("63 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e"),
                       "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488")
    test.case("64 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"),
                       "fdeab9acf3710362bd2658cdc9a29e8f9c757fcf9811603a8c447cd1d9151108")
    test.case("65 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40"),
                       "4bfd2c8b6f1eec7a2afeb48b934ee4b2694182027e6d0fc075074f2fabb31781")
    test.case("119 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f70717273747576"),
                       "da18797ed7c3a777f0847f429724a2d8cd5138e6ed2895c3fa1a6d39d18f7ec6")
    test.case("120 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f7071727374757677"),
                       "f52b23db1fbb6ded89ef42a23ce0c8922c45f25c50b568a93bf1c075420bbb7c")
    test.case("128 bytes")
    test.assert_eq_str(sha("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f"),
                       "471fb943aa23c511f6f72f8d1652d9c880cfa392ad80503120547703e56a2be5")
    test.case("192 bytes")
    test.assert_eq_str(sha(""),
                       "8b4a544837a1a0280fa8a7c82865c27a1064b3cc6281fda0753566b9bb104a87")
    test.case("200 bytes")
    test.assert_eq_str(sha(""),
                       "1901da1c9f699b48f6b2636e65cbf73abf99d0441ef67f5c540a42f7051dec6f")
    test.case("256 bytes")
    test.assert_eq_str(sha(""),
                       "5bc31b283cef0072274e97d74916552954c935794536cab632641e5ea071379d")

@test
fn test_hmac_sha256_of_rfc_4231() [io]
    test.case("test case 1: a key of 20 bytes and 8 bytes of data")
    test.assert_eq_str(mac("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b",
                          "4869205468657265"),
                       "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    test.case("test case 2: a key of 4 bytes and 28 bytes of data")
    test.assert_eq_str(mac("4a656665",
                          "7768617420646f2079612077616e7420666f72206e6f7468696e673f"),
                       "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    test.case("test case 3: a key of 20 bytes and 50 bytes of data")
    test.assert_eq_str(mac("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                          "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"),
                       "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    test.case("test case 4: a key of 25 bytes and 50 bytes of data")
    test.assert_eq_str(mac("0102030405060708090a0b0c0d0e0f10111213141516171819",
                          "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"),
                       "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
    test.case("test case 6: a key of 131 bytes and 54 bytes of data")
    test.assert_eq_str(mac("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                          "54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374"),
                       "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    test.case("test case 7: a key of 131 bytes and 152 bytes of data")
    test.assert_eq_str(mac("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                          ""),
                       "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")

@test
fn test_hkdf_sha256_of_rfc_5869() [io]
    test.case("appendix A.1: the PRK, and the first 32 bytes of the OKM")
    test.assert_eq_str(hkdf_first("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b",
                                 "000102030405060708090a0b0c",
                                 "f0f1f2f3f4f5f6f7f8f9"),
                       "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5/3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf")
    test.case("appendix A.2: the PRK, and the first 32 bytes of the OKM")
    test.assert_eq_str(hkdf_first("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f",
                                 "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf",
                                 "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"),
                       "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244/b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c")
    test.case("appendix A.3: the PRK, and the first 32 bytes of the OKM")
    test.assert_eq_str(hkdf_first("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b",
                                 "",
                                 ""),
                       "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04/8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d")

@test
fn test_hmac_cuts_what_does_not_fit_and_hashes_what_it_is_given() [io]
    test.case("a message past 192 bytes is cut to 192")
    var k = load("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    var long = load("")
    var cut = load("")
    var a: Vec[u8; 32] = Vec.new()
    var b: Vec[u8; 32] = Vec.new()
    osckdf.hmac_sha256(var k, 20, var long, 255, var a)
    osckdf.hmac_sha256(var k, 20, var cut, 192, var b)
    test.assert_eq_str(hex32(var a), hex32(var b))
    test.case("a length past the buffer is cut to what the buffer holds")
    var short = load("6162")
    var c: Vec[u8; 32] = Vec.new()
    var d: Vec[u8; 32] = Vec.new()
    osckdf.hmac_sha256(var k, 500, var short, 500, var c)
    osckdf.hmac_sha256(var k, 20, var short, 2, var d)
    test.assert_eq_str(hex32(var c), hex32(var d))
    test.case("sha256 cuts its length to the buffer too")
    var e: Vec[u8; 32] = Vec.new()
    osckdf.sha256(var short, 99, var e)
    test.assert_eq_str(hex32(var e), sha("6162"))
    test.case("an info longer than 191 bytes is cut to it")
    var prk: Vec[u8; 32] = Vec.new()
    var salt = load("")
    osckdf.hkdf_extract(var salt, 0, var k, 20, var prk)
    var info = load("")
    var info_cut = load("")
    var t1: Vec[u8; 32] = Vec.new()
    var t2: Vec[u8; 32] = Vec.new()
    osckdf.hkdf_expand_first(var prk, var info, 250, var t1)
    osckdf.hkdf_expand_first(var prk, var info_cut, 191, var t2)
    test.assert_eq_str(hex32(var t1), hex32(var t2))
    test.case("an info length past the buffer is cut to what it holds")
    var tiny = load("cd")
    var t3: Vec[u8; 32] = Vec.new()
    var t4: Vec[u8; 32] = Vec.new()
    osckdf.hkdf_expand_first(var prk, var tiny, 5, var t3)
    osckdf.hkdf_expand_first(var prk, var tiny, 1, var t4)
    test.assert_eq_str(hex32(var t3), hex32(var t4))
