// oscccm_tests.nv — AES-CCM with a 13-byte nonce and an 8-byte tag.
//
// GENERATED by tests/generate/gen_ccm_vectors.py from the text of RFC 3610 and
// RFC 8392; edit the generator, not this file.
//
// RFC 3610 section 8 gives 24 packet vectors, each an input packet of which the
// first bytes are additional data, and the authenticated and encrypted output.
// Those with a 13-byte nonce and an 8-byte tag, vectors 1 to 12, are the
// parameters of AES-CCM-16-64-128 and are all here: each is sealed and compared
// byte for byte, and its output is opened again.  The last test opens the
// encrypted CWT of RFC 8392 appendix A.5, which uses the same algorithm as COSE
// algorithm 10, and compares the plaintext with the claims set of A.1.  Nothing
// here was computed by this package.

use std.test
use std.bytes
use oscccm

fn load_key(s: Str) -> Vec[u8; 16]
    var k: Vec[u8; 16] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = k.push((bytes.byte_at(raw, i) ?? 0) as u8)
    k

fn load_nonce(s: Str) -> Vec[u8; 13]
    var n: Vec[u8; 13] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = n.push((bytes.byte_at(raw, i) ?? 0) as u8)
    n

fn load_aad(s: Str) -> Vec[u8; 128]
    var a: Vec[u8; 128] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = a.push((bytes.byte_at(raw, i) ?? 0) as u8)
    a

fn load_msg(s: Str) -> Vec[u8; 1152]
    var m: Vec[u8; 1152] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = m.push((bytes.byte_at(raw, i) ?? 0) as u8)
    m

fn msg_hex(var m: Vec[u8; 1152]) -> Str
    var b = bytes.zeros(m.len())
    for i in 0..m.len()
        bytes.set_u8(b, i, m[i] as Int)
    bytes.to_hex(b)

// Seal `plain` under `aad`, and compare with the RFC's output; then open the output.
fn vector(label: Str, key: Str, nonce: Str, aad: Str, plain: Str, sealed: Str)
    test.case(label)
    var k = load_key(key)
    var n = load_nonce(nonce)
    var a = load_aad(aad)
    var m = load_msg(plain)
    test.assert_eq(oscccm.seal(var k, var n, var a, var m, 0), true)
    test.assert_eq_str(msg_hex(var m), sealed)
    var o = load_msg(sealed)
    test.assert_eq(oscccm.open(var k, var n, var a, var o, 0), true)
    test.assert_eq_str(msg_hex(var o), plain)

@test
