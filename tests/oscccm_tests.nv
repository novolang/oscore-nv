@test
fn test_the_encrypted_cwt_of_rfc_8392_a5_opens() [io]
    test.case("A.5: the COSE_Encrypt0 of the example, key of A.2.1, IV in the unprotected header")
    var k = load_key("231f4c4d4d3051fdc2ec0a3851d5b383")
    var n = load_nonce("99a0d7846e762c49ffe8a63e0b")
    // The additional data is the Enc_structure of RFC 9052 section 5.3: an array of 3, the text
    // "Encrypt0", the protected header a1010a (alg 10) as a byte string, and an empty external_aad.
    var a = load_aad("8368456e63727970743043a1010a40")
    var m = load_msg("b918a11fd81e438b7f973d9e2e119bcb22424ba0f38a80f27562f400ee1d0d6c0fdb559c02421fd384fc2ebe22d7071378b0ea7428fff157444d45f7e6afcda1aae5f6495830c58627087fc5b4974f319a8707a635dd643b")
    test.assert_eq(oscccm.open(var k, var n, var a, var m, 0), true)
    test.assert_eq_str(msg_hex(var m),
        "a70175636f61703a2f2f61732e6578616d706c652e636f6d02656572696b77037818636f61703a2f2f6c696768742e6578616d706c652e636f6d041a5612aeb0051a5610d9f0061a5610d9f007420b71")
    test.case("the same token with its protected header changed does not open")
    var bad = load_aad("8368456e63727970743043a1010b40")
    var m2 = load_msg("b918a11fd81e438b7f973d9e2e119bcb22424ba0f38a80f27562f400ee1d0d6c0fdb559c02421fd384fc2ebe22d7071378b0ea7428fff157444d45f7e6afcda1aae5f6495830c58627087fc5b4974f319a8707a635dd643b")
    test.assert_eq(oscccm.open(var k, var n, var bad, var m2, 0), false)
    test.assert_eq(m2.len(), 0)

@test
fn test_a_message_that_does_not_verify_gives_nothing_back() [io]
    var k = load_key("c0c1c2c3c4c5c6c7c8c9cacbcccdcecf")
    var n = load_nonce("00000003020100a0a1a2a3a4a5")
    var a = load_aad("0001020304050607")
    test.case("a bit flipped in the ciphertext")
    var m = load_msg("598c979a61c663d2f066d0c2c0f989806d5f6b61dac38417e8d12cfdf926e0")
    test.assert_eq(oscccm.open(var k, var n, var a, var m, 0), false)
    test.assert_eq(m.len(), 0)
    test.case("a bit flipped in the tag")
    var t = load_msg("588c979a61c663d2f066d0c2c0f989806d5f6b61dac38417e8d12cfdf926e1")
    test.assert_eq(oscccm.open(var k, var n, var a, var t, 0), false)
    test.case("additional data of another length")
    var short = load_aad("00010203040506")
    var u = load_msg("588c979a61c663d2f066d0c2c0f989806d5f6b61dac38417e8d12cfdf926e0")
    test.assert_eq(oscccm.open(var k, var n, var short, var u, 0), false)
    test.case("another nonce")
    var other = load_nonce("00000003020100a0a1a2a3a4a6")
    var v = load_msg("588c979a61c663d2f066d0c2c0f989806d5f6b61dac38417e8d12cfdf926e0")
    test.assert_eq(oscccm.open(var k, var other, var a, var v, 0), false)
    test.case("a message shorter than the tag")
    var w = load_msg("0102030405")
    test.assert_eq(oscccm.open(var k, var n, var a, var w, 0), false)
    test.case("a start past the end")
    var x = load_msg("588c979a61c663d2f066d0c2c0f989806d5f6b61dac38417e8d12cfdf926e0")
    test.assert_eq(oscccm.open(var k, var n, var a, var x, 99), false)
    test.assert_eq(oscccm.open(var k, var n, var a, var x, -1), false)

@test
fn test_seal_and_open_work_from_an_offset_and_refuse_what_does_not_fit() [io]
    var k = load_key("c0c1c2c3c4c5c6c7c8c9cacbcccdcecf")
    var n = load_nonce("00000003020100a0a1a2a3a4a5")
    var a = load_aad("0001020304050607")
    test.case("the bytes before the start are left as they are")
    var m = load_msg("aabbcc" + "08090a0b0c0d0e0f101112131415161718191a1b1c1d1e")
    test.assert_eq(oscccm.seal(var k, var n, var a, var m, 3), true)
    test.assert_eq_str(msg_hex(var m), "aabbcc" + "588c979a61c663d2f066d0c2c0f989806d5f6b61dac38417e8d12cfdf926e0")
    test.assert_eq(oscccm.open(var k, var n, var a, var m, 3), true)
    test.assert_eq_str(msg_hex(var m), "aabbcc" + "08090a0b0c0d0e0f101112131415161718191a1b1c1d1e")
    test.case("a start past the end, or negative, is refused and the message is as it was")
    var p = load_msg("0102")
    test.assert_eq(oscccm.seal(var k, var n, var a, var p, 3), false)
    test.assert_eq(oscccm.seal(var k, var n, var a, var p, -1), false)
    test.assert_eq_str(msg_hex(var p), "0102")
    test.case("a message with no room for the tag")
    var full: Vec[u8; 1152] = Vec.new()
    for _i in 0..1149
        let _q = full.push(7)
    test.assert_eq(oscccm.seal(var k, var n, var a, var full, 0), false)
    test.assert_eq(full.len(), 1149)
    test.case("an empty plaintext is sealed to its tag alone, and opens")
    var e: Vec[u8; 1152] = Vec.new()
    test.assert_eq(oscccm.seal(var k, var n, var a, var e, 0), true)
    test.assert_eq(e.len(), 8)
    test.assert_eq(oscccm.open(var k, var n, var a, var e, 0), true)
    test.assert_eq(e.len(), 0)
    test.case("no additional data is a different message from empty additional data in a block")
    var none: Vec[u8; 128] = Vec.new()
    var r = load_msg("08090a0b0c0d0e0f101112131415161718191a1b1c1d1e")
    test.assert_eq(oscccm.seal(var k, var n, var none, var r, 0), true)
    test.assert_eq(oscccm.open(var k, var n, var none, var r, 0), true)
    test.assert_eq_str(msg_hex(var r), "08090a0b0c0d0e0f101112131415161718191a1b1c1d1e")
    test.case("additional data that fills more than one block")
    var long = load_aad("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2021222324252627")
    var s = load_msg("08090a0b0c0d0e0f101112131415161718191a1b1c1d1e")
    test.assert_eq(oscccm.seal(var k, var n, var long, var s, 0), true)
    test.assert_eq(oscccm.open(var k, var n, var long, var s, 0), true)
    test.assert_eq_str(msg_hex(var s), "08090a0b0c0d0e0f101112131415161718191a1b1c1d1e")
