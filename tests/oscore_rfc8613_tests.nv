// A request: protect it with the client's context at sequence number 20, compare with the
// RFC's protected message and its pieces, and verify it with the server's context.
fn request(label: Str, var client: OscoreCtx, var server: OscoreCtx, m_plain: Str, m_prot: Str,
           m_opt: Str, m_nonce: Str)
    test.case(label)
    // Sequence number 20, by the restore procedure of Appendix B.1.1: 10 stored, K = 5, F = 5.
    test.assert_eq(oscctx.ssn_restore(var client, 10, 5, 5), true)
    var req = load_msg(m_plain)
    var out: Vec[u8; 1152] = Vec.new()
    var rs = oscmsg.new_req()
    test.assert_eq(oscmsg.protect_request(var client, var req, var out, var rs), oscmsg.OSC_OK)
    test.assert_eq_str(hex_of(var out), m_prot)
    test.assert_eq_str(hex_nonce(var rs.nonce), m_nonce)
    test.assert_eq(rs.piv, 20)
    test.assert_eq(client.ssn, 21)
    var back: Vec[u8; 1152] = Vec.new()
    var srs = oscmsg.new_req()
    test.assert_eq(oscmsg.unprotect_request(var server, var out, var back, var srs), oscmsg.OSC_OK)
    test.assert_eq_str(hex_of(var back), m_plain)
    test.assert_eq(srs.piv, 20)
    test.assert_eq_str(hex_nonce(var srs.nonce), m_nonce)
    test.case(label + ": the same request again is a replay")
    var again: Vec[u8; 1152] = Vec.new()
    test.assert_eq(oscmsg.unprotect_request(var server, var out, var again, var srs), oscmsg.OSC_E_REPLAY)

@test
fn test_c4_a_request_with_a_master_salt() [io]
    var client = derive("0102030405060708090a0b0c0d0e0f10", "9e7ca92223786340", "", "01", "-")
    var server = derive("0102030405060708090a0b0c0d0e0f10", "9e7ca92223786340", "01", "", "-")
    request("C.4", var client, var server,
            "44015d1f00003974396c6f63616c686f737483747631",
            "44025d1f00003974396c6f63616c686f7374620914ff612f1092f1776f1c1668b3825e",
            "0914",
            "4622d4dd6d944168eefb549868")

@test
fn test_c5_a_request_without_a_master_salt() [io]
    var client = derive("0102030405060708090a0b0c0d0e0f10", "", "00", "01", "-")
    var server = derive("0102030405060708090a0b0c0d0e0f10", "", "01", "00", "-")
    request("C.5", var client, var server,
            "440171c30000b932396c6f63616c686f737483747631",
            "440271c30000b932396c6f63616c686f737463091400ff4ed339a5a379b0b8bc731fffb0",
            "091400",
            "bf35ae297d2dace910c52e99ed")

@test
fn test_c6_a_request_with_an_id_context() [io]
    var client = derive("0102030405060708090a0b0c0d0e0f10", "9e7ca92223786340", "", "01", "37cbf3210017a2d3")
    var server = derive("0102030405060708090a0b0c0d0e0f10", "9e7ca92223786340", "01", "", "37cbf3210017a2d3")
    request("C.6", var client, var server,
            "44012f8eef9bbf7a396c6f63616c686f737483747631",
            "44022f8eef9bbf7a396c6f63616c686f73746b19140837cbf3210017a2d3ff72cd7273fd331ac45cffbe55c3",
            "19140837cbf3210017a2d3",
            "2ca58fb85ff1b81c0b7181b84a")

// The response of C.7 and C.8 to the request of C.4: the server verifies the request, answers, the
// client verifies the answer.
fn response(label: Str, with_piv: Bool, m_plain: Str, m_prot: Str)
    test.case(label)
    var client = derive("0102030405060708090a0b0c0d0e0f10", "9e7ca92223786340", "", "01", "-")
    var server = derive("0102030405060708090a0b0c0d0e0f10", "9e7ca92223786340", "01", "", "-")
    // Sequence number 20, by the restore procedure of Appendix B.1.1: 10 stored, K = 5, F = 5.
    test.assert_eq(oscctx.ssn_restore(var client, 10, 5, 5), true)
    var req = load_msg("44015d1f00003974396c6f63616c686f737483747631")
    var wire: Vec[u8; 1152] = Vec.new()
    var crs = oscmsg.new_req()
    test.assert_eq(oscmsg.protect_request(var client, var req, var wire, var crs), oscmsg.OSC_OK)
    var seen: Vec[u8; 1152] = Vec.new()
    var srs = oscmsg.new_req()
    test.assert_eq(oscmsg.unprotect_request(var server, var wire, var seen, var srs), oscmsg.OSC_OK)
    var resp = load_msg(m_plain)
    var out: Vec[u8; 1152] = Vec.new()
    test.assert_eq(oscmsg.protect_response(var server, var resp, var out, var srs, with_piv), oscmsg.OSC_OK)
    test.assert_eq_str(hex_of(var out), m_prot)
    var back: Vec[u8; 1152] = Vec.new()
    test.assert_eq(oscmsg.unprotect_response(var client, var out, var back, var crs), oscmsg.OSC_OK)
    test.assert_eq_str(hex_of(var back), m_plain)

@test
fn test_c7_a_response_without_a_partial_iv_and_c8_with_one() [io]
    response("C.7", false, "64455d1f00003974ff48656c6c6f20576f726c6421",
             "64445d1f0000397490ffdbaad1e9a7e7b2a813d3c31524378303cdafae119106")
    response("C.8", true, "64455d1f00003974ff48656c6c6f20576f726c6421",
             "64445d1f00003974920100ff4d4c13669384b67354b2b6175ff4b8658c666a6cf88e")
