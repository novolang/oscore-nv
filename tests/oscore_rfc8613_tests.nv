// oscore_rfc8613_tests.nv — RFC 8613 appendix C, byte for byte.
//
// GENERATED by tests/generate/gen_oscore_vectors.py from the text of the RFC; edit
// the generator, not this file.
//
// C.1 to C.3 derive a security context for the client and for the server from a
// master secret, with a master salt, without one and with an ID Context: the info
// of the HKDF, the Sender Key, the Recipient Key, the Common IV and the nonces of
// Partial IV 0.  C.4 to C.6 protect a GET request with those contexts at sequence
// number 20 and give the protected message.  C.7 and C.8 protect the response to the
// request of C.4, without a Partial IV and with one.  Each is built here and
// compared with the RFC's bytes, and each protected message is verified by the
// other end and has to give the original message back.  Nothing here was computed
// by this package.

use std.test
use std.bytes
use oscctx
use oscmsg

fn hex_of(var m: Vec[u8; 1152]) -> Str
    var b = bytes.zeros(m.len())
    for i in 0..m.len()
        bytes.set_u8(b, i, m[i] as Int)
    bytes.to_hex(b)

fn load256(s: Str) -> Vec[u8; 256]
    var m: Vec[u8; 256] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = m.push((bytes.byte_at(raw, i) ?? 0) as u8)
    m

fn load_msg(s: Str) -> Vec[u8; 1152]
    var m: Vec[u8; 1152] = Vec.new()
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    for i in 0..bytes.len(raw)
        let _p = m.push((bytes.byte_at(raw, i) ?? 0) as u8)
    m

fn hex_vec(var v: Vec[u8; 16]) -> Str
    var b = bytes.zeros(v.len())
    for i in 0..v.len()
        bytes.set_u8(b, i, v[i] as Int)
    bytes.to_hex(b)

fn hex_nonce(var v: Vec[u8; 13]) -> Str
    var b = bytes.zeros(v.len())
    for i in 0..v.len()
        bytes.set_u8(b, i, v[i] as Int)
    bytes.to_hex(b)

fn hex_info(var v: Vec[u8; 256]) -> Str
    var b = bytes.zeros(v.len())
    for i in 0..v.len()
        bytes.set_u8(b, i, v[i] as Int)
    bytes.to_hex(b)

// An identifier of up to 7 bytes in an Int, the first byte highest.
fn id_value(s: Str) -> Int
    let raw = bytes.from_hex(s) ?? bytes.zeros(0)
    var v = 0
    for i in 0..bytes.len(raw)
        v = (v << 8) | (bytes.byte_at(raw, i) ?? 0)
    v

fn id_len(s: Str) -> Int
    bytes.len(bytes.from_hex(s) ?? bytes.zeros(0))

// Derive a context from the RFC's inputs.  `ctx` is the ID Context in hex, or "-" for none.
fn derive(secret: Str, salt: Str, sid: Str, rid: Str, ctx: Str) -> OscoreCtx
    var sec = load256(secret)
    var sal = load256(salt)
    var c = oscctx.new_ctx()
    if ctx == "-"
        var none = load256("")
        let _a = oscctx.derive(var c,
            var sec,
            sec.len(),
            var sal,
            sal.len(),
            id_value(sid),
            id_len(sid),
            id_value(rid),
            id_len(rid),
            var none,
            -1)
    else
        var idc = load256(ctx)
        let _b = oscctx.derive(var c,
            var sec,
            sec.len(),
            var sal,
            sal.len(),
            id_value(sid),
            id_len(sid),
            id_value(rid),
            id_len(rid),
            var idc,
            idc.len())
    c

// One derivation: the info strings, the keys, the Common IV and the nonces of Partial IV 0.
fn derivation(label: Str, secret: Str, salt: Str, sid: Str, rid: Str, ctx: Str, info_s: Str,
              info_r: Str, info_iv: Str, skey: Str, rkey: Str, civ: Str, snonce: Str, rnonce: Str)
    test.case(label)
    var c = derive(secret, salt, sid, rid, ctx)
    test.assert_eq_str(hex_vec(var c.sender_key), skey)
    test.assert_eq_str(hex_vec(var c.recipient_key), rkey)
    test.assert_eq_str(hex_nonce(var c.common_iv), civ)
    var sn = oscctx.nonce(var c.common_iv, c.sender_id, c.sender_id_len, 0)
    var rn = oscctx.nonce(var c.common_iv, c.recipient_id, c.recipient_id_len, 0)
    test.assert_eq_str(hex_nonce(var sn), snonce)
    test.assert_eq_str(hex_nonce(var rn), rnonce)
    var info: Vec[u8; 256] = Vec.new()
    var idc = load256((if ctx == "-" then "" else ctx))
    let has = ctx != "-"
    oscctx.make_info(var info, c.sender_id, c.sender_id_len, has, var idc, idc.len(), true)
    test.assert_eq_str(hex_info(var info), info_s)
    oscctx.make_info(var info, c.recipient_id, c.recipient_id_len, has, var idc, idc.len(), true)
    test.assert_eq_str(hex_info(var info), info_r)
    oscctx.make_info(var info, 0, 0, has, var idc, idc.len(), false)
    test.assert_eq_str(hex_info(var info), info_iv)

